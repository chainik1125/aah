#!/bin/bash
# Threading environment variables for optimal performance
# Source this file before running Python scripts:
#   source .env.threading

export OMP_NUM_THREADS=48
export OPENBLAS_NUM_THREADS=48
export MKL_NUM_THREADS=48
export NUMEXPR_NUM_THREADS=48
export VECLIB_MAXIMUM_THREADS=48
export NUMBA_NUM_THREADS=48
